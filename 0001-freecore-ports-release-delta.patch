diff --git a/lang/python311/files/patch-configparser-eol-normalization b/lang/python311/files/patch-configparser-eol-normalization
new file mode 100644
index 0000000000000000000000000000000000000000..1ed6a83848e22b75a4958001447165342236a39a
--- /dev/null
+++ b/lang/python311/files/patch-configparser-eol-normalization
@@ -0,0 +1,19 @@
+Normalise all line endings when writing values, not just '\n', so a value
+containing CR or CRLF cannot emit a config file that re-parses differently
+from what was written.
+
+Taken verbatim from the upstream CPython 3.11 branch (Lib/configparser.py).
+
+--- Lib/configparser.py.orig
++++ Lib/configparser.py
+@@ -949,7 +949,9 @@
+             value = self._interpolation.before_write(self, section_name, key,
+                                                      value)
+             if value is not None or not self._allow_no_value:
+-                value = delimiter + str(value).replace('\n', '\n\t')
++                # Convert all possible line-endings into '\n\t'
++                value = (delimiter + str(value).replace('\r\n', '\n')
++                         .replace('\r', '\n').replace('\n', '\n\t'))
+             else:
+                 value = ""
+             fp.write("{}{}\n".format(key, value))
diff --git a/lang/python311/files/patch-http-response-bounds b/lang/python311/files/patch-http-response-bounds
new file mode 100644
index 0000000000000000000000000000000000000000..c1b620a53a3f7f5e7c222b8965510abf210cb64a
--- /dev/null
+++ b/lang/python311/files/patch-http-response-bounds
@@ -0,0 +1,66 @@
+Bound unbounded interim (1xx) responses and chunked-trailer lines so a hostile
+or broken server cannot hang getresponse() indefinitely.  A socket timeout does
+not detect this, because data keeps arriving inside every timeout window.
+
+Taken verbatim from the upstream CPython 3.11 branch (Lib/http/client.py).
+The CONNECT tunnel CR/LF guard named by the matching advisory is already
+present in 3.11.15 via _contains_disallowed_url_pchar_re and is unchanged here.
+
+--- Lib/http/client.py.orig
++++ Lib/http/client.py
+@@ -110,6 +110,13 @@
+ # maximal line length when calling readline().
+ _MAXLINE = 65536
+ _MAXHEADERS = 100
++
++# maximal number of interim (1xx) responses tolerated before the final
++# response.  Real servers send at most a few; without a bound, a server
++# streaming "100 Continue" responses would hang getresponse() forever.
++# A socket timeout cannot detect that as data keeps arriving within every
++# timeout window.
++_MAXINTERIMRESPONSES = 100
+ 
+ # Data larger than this will be read in chunks, to prevent extreme
+ # overallocation.
+@@ -326,7 +333,7 @@
+             return
+ 
+         # read until we get a non-100 response
+-        while True:
++        for _ in range(_MAXINTERIMRESPONSES):
+             version, status, reason = self._read_status()
+             if status != CONTINUE:
+                 break
+@@ -335,6 +342,9 @@
+             if self.debuglevel > 0:
+                 print("headers:", skipped_headers)
+             del skipped_headers
++        else:
++            raise HTTPException(
++                f"got more than {_MAXINTERIMRESPONSES} interim responses")
+ 
+         self.code = self.status = status
+         self.reason = reason.strip()
+@@ -552,6 +562,7 @@
+     def _read_and_discard_trailer(self):
+         # read and discard trailer up to the CRLF terminator
+         ### note: we shouldn't have any trailers!
++        trailers_read = 0
+         while True:
+             line = self.fp.readline(_MAXLINE + 1)
+             if len(line) > _MAXLINE:
+@@ -562,6 +573,14 @@
+                 break
+             if line in (b'\r\n', b'\n', b''):
+                 break
++            # Bound the trailer count just as response headers are bounded.
++            # A server streaming trailer lines forever would otherwise hang
++            # the client; a socket timeout cannot detect that as data keeps
++            # arriving within every timeout window.
++            trailers_read += 1
++            if trailers_read > _MAXHEADERS:
++                raise HTTPException(
++                    f"got more than {_MAXHEADERS} trailers")
+ 
+     def _get_chunk_left(self):
+         # return self.chunk_left, reading a new chunk if necessary.
diff --git a/lang/python311/files/patch-imaplib-poplib-command-validation b/lang/python311/files/patch-imaplib-poplib-command-validation
new file mode 100644
index 0000000000000000000000000000000000000000..ad5e86f8fa616886e1964208065a58440cc5a07d
--- /dev/null
+++ b/lang/python311/files/patch-imaplib-poplib-command-validation
@@ -0,0 +1,87 @@
+The IMAP changes are adapted from the combined upstream 3.13 backport
+71926d943c05bde79bd2a866933103541d91b6a2.  Python 3.11 does not have
+the later automatic quoting behavior, so preserve its handling of other C0
+characters and reject only the protocol-unsafe NUL, CR, and LF characters.
+
+The POP changes are adapted from upstream
+b234a2b67539f787e191d2ef19a7cbdce32874e7.
+
+--- Lib/imaplib.py.orig
++++ Lib/imaplib.py
+@@ -132,6 +132,8 @@
+ # We compile these in _mode_xxx.
+ _Literal = br'.*{(?P<size>\d+)}$'
+ _Untagged_status = br'\* (?P<data>\d+) (?P<type>[A-Z-]+)( (?P<data2>.*))?'
++# NUL, CR, and LF cannot be represented safely in an IMAP command.
++_control_chars = re.compile(b'[\x00\r\n]')
+ 
+ 
+ 
+@@ -994,6 +996,8 @@
+             if arg is None: continue
+             if isinstance(arg, str):
+                 arg = bytes(arg, self._encoding)
++            if _control_chars.search(arg):
++                raise ValueError("NUL, CR and LF not allowed in commands")
+             data = data + b' ' + arg
+ 
+         literal = self.literal
+--- Lib/poplib.py.orig
++++ Lib/poplib.py
+@@ -122,6 +122,8 @@
+     def _putcmd(self, line):
+         if self._debugging: print('*cmd*', repr(line))
+         line = bytes(line, self.encoding)
++        if re.search(b'[\x00-\x1F\x7F]', line):
++            raise ValueError('Control characters not allowed in commands')
+         self._putline(line)
+ 
+ 
+--- Lib/test/test_imaplib.py.orig
++++ Lib/test/test_imaplib.py
+@@ -543,6 +543,20 @@
+         self.assertEqual(data[0], b'Returned to authenticated state. (Success)')
+         self.assertEqual(client.state, 'AUTH')
+ 
++    def test_unsafe_command_characters(self):
++        client, _ = self._setup(SimpleIMAPHandler)
++        client.login('user', 'pass')
++        for character in '\0\r\n':
++            with self.subTest(character=character):
++                with self.assertRaises(ValueError):
++                    client.select(f'a{character}b')
++
++        # The backport must not broaden the rejection to other C0 controls.
++        for character in ('\x01', '\x7f'):
++            with self.subTest(character=character):
++                typ, _ = client.select(f'a{character}b')
++                self.assertEqual(typ, 'OK')
++
+ 
+ class NewIMAPTests(NewIMAPTestsMixin, unittest.TestCase):
+     imap_class = imaplib.IMAP4
+--- Lib/test/test_poplib.py.orig
++++ Lib/test/test_poplib.py
+@@ -16,6 +16,7 @@
+ from test.support import socket_helper
+ from test.support import threading_helper
+ from test.support import warnings_helper
++from test.support import control_characters_c0
+ 
+ 
+ asynchat = warnings_helper.import_deprecated('asynchat')
+@@ -367,6 +368,14 @@
+         self.assertIsNone(self.client.sock)
+         self.assertIsNone(self.client.file)
+ 
++    def test_control_characters(self):
++        for character in control_characters_c0():
++            with self.subTest(character=character):
++                with self.assertRaises(ValueError):
++                    self.client.user(f'user{character}')
++                with self.assertRaises(ValueError):
++                    self.client.pass_(f'{character}pass')
++
+     @requires_ssl
+     def test_stls_capa(self):
+         capa = self.client.capa()
