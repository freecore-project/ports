++static int geom_init (void) /* {{{ */
++{
++	int error, i;
++	DEBUG("geom_stat: geom_init");
++	if ( !initDone ){
++		DEBUG("geom_stat: geom_init - running init.");
++		fliterSet = 0;
++		i = geom_gettree(&gmp);
++		if (i != 0)
++			err(1, "geom_gettree = %d", i);
++		error = geom_stats_open();
