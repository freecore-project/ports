++
++	} else if (strcasecmp(key, "ValuesAbsolute") == 0) {
++		nfsstat_flags &= ~NFSSTAT_PERCENTAGE;
++
++	} else if (strcasecmp(key, "ValuesPercentage") == 0) {
++		nfsstat_flags |= NFSSTAT_PERCENTAGE;
++	}
++
++	return (0);
++}
