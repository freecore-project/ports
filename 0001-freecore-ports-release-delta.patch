++			err(1, "geom_stats_snapshot()");
++		geom_stats_snapshot_timestamp(sq, &tq);
++	}
++	
++	if ( fliterSet == 0 ) {
++		if ( regcomp(&f_re, "^[a]?da[0123456789]+$", REG_EXTENDED) == 0 ) {
++			fliterSet = 1;
++		}
++	}
++	initDone = 1;
++	DEBUG("geom_stat: geom_init - complete.");
