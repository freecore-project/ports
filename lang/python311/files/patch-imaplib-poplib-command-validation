         self.assertEqual(data[0], b'Returned to authenticated state. (Success)')
         self.assertEqual(client.state, 'AUTH')
 
+    def test_unsafe_command_characters(self):
+        client, _ = self._setup(SimpleIMAPHandler)
+        client.login('user', 'pass')
+        for character in '\0\r\n':
+            with self.subTest(character=character):
+                with self.assertRaises(ValueError):
+                    client.select(f'a{character}b')
+
+        # The backport must not broaden the rejection to other C0 controls.
+        for character in ('\x01', '\x7f'):
+            with self.subTest(character=character):
+                typ, _ = client.select(f'a{character}b')
+                self.assertEqual(typ, 'OK')
+
 
