Python 3.12: reject protocol-unsafe characters in IMAP
and POP3 commands.

The IMAP changes are adapted from the combined upstream 3.13 backport
71926d943c05bde79bd2a866933103541d91b6a2 (gh-143921).  Python 3.12, like
3.11, does not have the later automatic quoting behavior, so preserve its
handling of other C0 characters and reject only the protocol-unsafe NUL, CR,
and LF characters.

The POP changes are adapted from upstream
b234a2b67539f787e191d2ef19a7cbdce32874e7 (gh-143923).

Upstream carries no 3.12 backport of either (checked 2026-09-30).  This is
lang/python311's patch of the same name regenerated against 3.12.14, whose
test_poplib imports differ.

--- Lib/imaplib.py.orig
+++ Lib/imaplib.py
@@ -132,6 +132,8 @@
 # We compile these in _mode_xxx.
 _Literal = br'.*{(?P<size>\d+)}$'
 _Untagged_status = br'\* (?P<data>\d+) (?P<type>[A-Z-]+)( (?P<data2>.*))?'
+# NUL, CR, and LF cannot be represented safely in an IMAP command.
+_control_chars = re.compile(b'[\x00\r\n]')
 
 
 
@@ -994,6 +996,8 @@
             if arg is None: continue
             if isinstance(arg, str):
                 arg = bytes(arg, self._encoding)
+            if _control_chars.search(arg):
+                raise ValueError("NUL, CR and LF not allowed in commands")
             data = data + b' ' + arg
 
         literal = self.literal
--- Lib/poplib.py.orig
+++ Lib/poplib.py
@@ -122,6 +122,8 @@
     def _putcmd(self, line):
         if self._debugging: print('*cmd*', repr(line))
         line = bytes(line, self.encoding)
+        if re.search(b'[\x00-\x1F\x7F]', line):
+            raise ValueError('Control characters not allowed in commands')
         self._putline(line)
 
 
