--- usr/local/etc/rc.d/bastille.orig	2026-02-19 00:00:00 UTC
+++ usr/local/etc/rc.d/bastille
@@ -36,9 +36,25 @@ start_cmd="bastille_start"
 stop_cmd="bastille_stop"
 restart_cmd="bastille_restart"
 
+bastille_middleware_ready() {
+    case "$(/usr/local/bin/midclt call system.ready 2>/dev/null)" in
+        true|True) return 0 ;;
+        *) return 1 ;;
+    esac
+}
+
+bastille_rc_preflight() {
+    /usr/local/bin/midclt call bastille.rc_preflight "${1}" >/dev/null
+}
+
+bastille_rc_postflight() {
+    /usr/local/bin/midclt call bastille.rc_postflight "${1}" >/dev/null
+}
+
 list_jails() {
-    local _jailsdir=$(. $bastille_conf; echo $bastille_jailsdir)
-    local _jail_list=$(find ${_jailsdir}/* -mindepth 1 -maxdepth 1 -type f -name jail.conf | xargs -n1 dirname | xargs -n1 basename)
+    local _jailsdir=${bastille_jailsdir:-$(. "${bastille_conf}"; echo "${bastille_jailsdir}")}
+    [ -d "${_jailsdir}" ] || return 0
+    local _jail_list=$(find "${_jailsdir}" -mindepth 2 -maxdepth 2 -type f -name jail.conf | xargs -n1 dirname | xargs -n1 basename)
     for _jail in ${_jail_list}; do
         _priority="$(sysrc -f ${_jailsdir}/${_jail}/settings.conf -n priority)"
         echo "${_jail} ${_priority}"
@@ -57,18 +73,57 @@ sort_jails() {
 }
 
 bastille_start() {
+    bastille_middleware_ready || return 0
+    bastille_rc_preflight "start" || return 1
     sort_jails "forward"
-    echo "${bastille_jail_list}" | xargs -P ${bastille_parallel_limit} -I JAIL ${command} start --boot --delay ${bastille_startup_delay} JAIL
+    [ -n "${bastille_jail_list}" ] || return 0
+    echo "${bastille_jail_list}" | xargs -P ${bastille_parallel_limit} -I JAIL /usr/bin/env -i \
+        BASTILLE_CONFIG="${bastille_conf}" \
+        LC_ALL=C \
+        NO_COLOR=1 \
+        PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin \
+        SH=/bin/sh \
+        UMASK=022 \
+        "${command}" start --boot --delay ${bastille_startup_delay} JAIL
+    local _status=$?
+    bastille_rc_postflight "start" || return 1
+    [ "${_status}" -eq 0 ]
 }
 
 bastille_stop() {
+    bastille_middleware_ready || return 0
+    bastille_rc_preflight "stop" || return 1
     sort_jails "reverse"
-    echo "${bastille_jail_list}" | xargs -P ${bastille_parallel_limit} -I JAIL ${command} stop JAIL
+    [ -n "${bastille_jail_list}" ] || return 0
+    echo "${bastille_jail_list}" | xargs -P ${bastille_parallel_limit} -I JAIL /usr/bin/env -i \
+        BASTILLE_CONFIG="${bastille_conf}" \
+        LC_ALL=C \
+        NO_COLOR=1 \
+        PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin \
+        SH=/bin/sh \
+        UMASK=022 \
+        "${command}" stop JAIL
+    local _status=$?
+    bastille_rc_postflight "stop" || return 1
+    [ "${_status}" -eq 0 ]
 }
 
 bastille_restart() {
+    bastille_middleware_ready || return 0
+    bastille_rc_preflight "restart" || return 1
     sort_jails "forward"
-    echo "${bastille_jail_list}" | xargs -P ${bastille_parallel_limit} -I JAIL ${command} restart --boot --delay ${bastille_startup_delay} JAIL
+    [ -n "${bastille_jail_list}" ] || return 0
+    echo "${bastille_jail_list}" | xargs -P ${bastille_parallel_limit} -I JAIL /usr/bin/env -i \
+        BASTILLE_CONFIG="${bastille_conf}" \
+        LC_ALL=C \
+        NO_COLOR=1 \
+        PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin \
+        SH=/bin/sh \
+        UMASK=022 \
+        "${command}" restart --boot --delay ${bastille_startup_delay} JAIL
+    local _status=$?
+    bastille_rc_postflight "restart" || return 1
+    [ "${_status}" -eq 0 ]
 }
 
 load_rc_config ${name}
